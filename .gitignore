# ===================================================================
# 1. Maven & Java Build Artifacts (Essencial para o seu projeto)
# ===================================================================
**/target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ===================================================================
# 2. Node, Angular, TypeScript & Liferay NPM Bundler
# ===================================================================
**/node/
**/node_modules/
**/node_modules_cache/
**/bower_components/
**/liferay-npm-bundler-report.html
**/.npmbundlerrc.log
**/*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.angular/

# Caso o tsc tenha gerado arquivos compilados dentro de resources/lib
**/src/main/resources/META-INF/resources/lib/

