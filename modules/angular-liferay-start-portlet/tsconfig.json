{
	"compileOnSave": false,
	"compilerOptions": {
		"outDir": "./target/tsc",
		"strict": false,
		"sourceMap": true,
		"declaration": false,
		"experimentalDecorators": true,
		"moduleResolution": "bundler",
		"importHelpers": true,
		"target": "ES2022",
		"module": "ES2022",
		"skipLibCheck": true,
		"lib": ["ES2022", "dom"]
	},
	"include": [
		"src/main/resources/META-INF/resources/lib/**/*.ts"
	]
}