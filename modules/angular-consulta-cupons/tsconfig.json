{
	"compilerOptions": {
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"lib": ["es2015", "dom"],
		"module": "commonjs",
		"moduleResolution": "node",
		"outDir": "target/classes/META-INF/resources/lib",
		"sourceMap": true,
		"skipLibCheck": true,
		"strict": false,
		"target": "es5",
		"typeRoots": ["./node_modules/@types"],
		"types": ["node"]
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"node_modules"
	]
}